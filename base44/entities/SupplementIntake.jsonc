{
  "name": "SupplementIntake",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email del usuario"
    },
    "supplement_id": {
      "type": "string",
      "description": "ID del suplemento tomado"
    },
    "supplement_name": {
      "type": "string",
      "description": "Nombre del suplemento (snapshot)"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Fecha en que se tom\u00f3"
    },
    "taken": {
      "type": "boolean",
      "default": true,
      "description": "Si se tom\u00f3 o no"
    }
  },
  "required": [
    "user_email",
    "supplement_id",
    "supplement_name",
    "date"
  ]
}